{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://https://civicpulse-api-jg1m.onrender.com.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://https://civicpulse-api-jg1m.onrender.com.com/media/:path*"
    },
    {
      "source": "/((?!api/|media/).*)",
      "destination": "/index.html"
    }
  ]
}
